# Required: absolute path to a dedicated directory containing gallery media.
MEDIA_PATH=/absolute/path/to/media

# Optional: persistent configuration directory. Defaults to ./config.
CONFIG_PATH=./config

# Optional: unused host port for the FolderFrame WebUI.
WEB_PORT=8088

# Optional overrides. Leave blank to use CONFIG_PATH/folderframe.config.json.
FOLDERFRAME_SOURCE_LABEL=
FOLDERFRAME_STARTING_VIEW=
FOLDERFRAME_DEFAULT_SORT=
FOLDERFRAME_SLIDESHOW_INTERVAL=
FOLDERFRAME_IMAGE_MODE=
FOLDERFRAME_AUTOPLAY=
FOLDERFRAME_SHUFFLE=
FOLDERFRAME_GALLERY_REFRESH_INTERVAL=
FOLDERFRAME_EMBED_REFRESH_INTERVAL=
FOLDERFRAME_REMEMBER_PREFERENCES=

# Persistent background thumbnails and media manifest. Independently configurable.
FOLDERFRAME_THUMBNAILS=true
FOLDERFRAME_MANIFEST=true
FOLDERFRAME_THUMBNAIL_INTERVAL=3600
FOLDERFRAME_THUMBNAIL_SIZE=480
FOLDERFRAME_THUMBNAIL_QUALITY=80
