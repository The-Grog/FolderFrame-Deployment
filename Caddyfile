{
	admin off
	auto_https off
}

:8080 {
	# Serve the generated runtime configuration before other app assets.
	handle /folderframe.config.json {
		root * /run/folderframe
		header Cache-Control "no-store"
		file_server
	}

	# The app's default source is photos/. Media is mounted separately.
	redir /photos /photos/ 308
	handle_path /photos/* {
		root * /media
		header Cache-Control "no-store"
		file_server browse {
			hide .*
		}
	}

	# Generated previews are persistent appdata, not original media.
	redir /thumbnails /thumbnails/ 308
	handle_path /thumbnails/* {
		root * /config/thumbnails
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		file_server
	}
}
